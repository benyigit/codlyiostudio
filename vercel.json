{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "studio.codlyio.com" }],
      "dest": "/office"
    },
    { "handle": "filesystem" }
  ]
}
